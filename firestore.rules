rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('admin', false) == true;
    }

    function isMaster() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('master', false) == true;
    }

    // Papel restrito de cozinha: só enxerga e avança pedidos, ao contrário
    // de admin/master (que também mexem em cardápio, parceiros e usuários).
    function isCozinha() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('cozinha', false) == true;
    }

    match /usuarios/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isMaster());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        !('admin' in request.resource.data) && !('master' in request.resource.data) &&
        !('cozinha' in request.resource.data);
      allow update: if isMaster() ||
        (isSignedIn() && request.auth.uid == userId &&
         request.resource.data.get('admin', false) == resource.data.get('admin', false) &&
         request.resource.data.get('master', false) == resource.data.get('master', false) &&
         request.resource.data.get('cozinha', false) == resource.data.get('cozinha', false));
      allow delete: if isMaster();
    }

    match /cardapio/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isMaster();
    }

    // Tempo estimado padrão por categoria (usado quando o prato não tem
    // um tempoEstimadoMin próprio). Doc id = nome da categoria.
    match /categorias/{categoriaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isMaster();
    }

    // Grade fixa de horários de retirada, cadastrada pelo admin e usada
    // pelo cliente na finalização do pedido.
    match /horarios_retirada/{slotId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isMaster();
    }

    match /parceiros/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isMaster();
    }

    match /pedidos/{pedidoId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'Aguardando pagamento' &&
        request.resource.data.horarioRetirada is string &&
        request.resource.data.horarioRetirada.size() > 0 &&
        get(/databases/$(database)/documents/horarios_retirada/$(request.resource.data.horarioRetirada))
          .data.get('ativo', false) == true;

      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin() || isMaster() || isCozinha());

      // Só essas transições de status são válidas da cozinha pra frente —
      // não dá pra pular etapa nem voltar o pedido pra trás.
      function transicaoValidaCozinha() {
        return
          (resource.data.status == 'Aguardando preparo' && request.resource.data.status == 'Em preparo') ||
          (resource.data.status == 'Em preparo' && request.resource.data.status == 'Pronto') ||
          (resource.data.status == 'Pronto' && request.resource.data.status == 'Entregue');
      }

      // O dono do pedido só pode alterar campos que não afetam o status, o
      // valor, o horário de retirada nem os dados de pagamento — tudo isso é
      // gerenciado exclusivamente pelas Cloud Functions (Admin SDK, que
      // ignora estas regras) via chamada direta ou webhook do Mercado Pago.
      // A cozinha só pode avançar o status do pedido, também sem tocar em
      // valor, dono, horário de retirada ou dados de pagamento.
      allow update: if isAdmin() || isMaster() ||
        (isCozinha() &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.total == resource.data.total &&
         request.resource.data.horarioRetirada == resource.data.horarioRetirada &&
         request.resource.data.get('metodoPagamento', null) == resource.data.get('metodoPagamento', null) &&
         request.resource.data.get('pagamentoRevisao', null) == resource.data.get('pagamentoRevisao', null) &&
         request.resource.data.get('mercadoPagoPaymentId', null) ==
           resource.data.get('mercadoPagoPaymentId', null) &&
         request.resource.data.get('mercadoPagoPreferenceId', null) ==
           resource.data.get('mercadoPagoPreferenceId', null) &&
         transicaoValidaCozinha()) ||
        (isSignedIn() && resource.data.userId == request.auth.uid &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.total == resource.data.total &&
         request.resource.data.horarioRetirada == resource.data.horarioRetirada &&
         request.resource.data.get('metodoPagamento', null) == resource.data.get('metodoPagamento', null) &&
         request.resource.data.get('pagamentoRevisao', null) == resource.data.get('pagamentoRevisao', null) &&
         request.resource.data.get('mercadoPagoPaymentId', null) ==
           resource.data.get('mercadoPagoPaymentId', null) &&
         request.resource.data.get('mercadoPagoPreferenceId', null) ==
           resource.data.get('mercadoPagoPreferenceId', null));

      allow delete: if isMaster();
    }
  }
}

