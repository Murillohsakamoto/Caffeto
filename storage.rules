rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Foto de perfil: avatars/{uid}.jpg. Cada usuário só escreve/apaga a
    // própria foto; leitura liberada pra qualquer usuário logado, já que
    // a foto aparece pra outras pessoas dentro do app (ex: cozinha).
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        fileName == request.auth.uid + '.jpg' &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null &&
        fileName == request.auth.uid + '.jpg';
    }

    // Foto dos produtos do cardápio: cardapio/{itemId}.jpg. Leitura pública
    // (o cardápio já é público pra visitante ver sem login — regra 5.1.1(v)
    // da Apple). Escrita só pela Cloud Function atualizarImagemCardapio
    // (Admin SDK, que ignora estas regras), nunca direto do app.
    match /cardapio/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Bloqueia qualquer outro caminho por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
